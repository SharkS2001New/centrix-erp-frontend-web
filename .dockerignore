# VCS, editor, CI
.git
.github
.cursor
.gitignore

# Env files (never bake real secrets into images)
.env
.env.*
!.env.local.example

# Build / tooling outputs
node_modules
.next
npm-debug.log*
test-results
playwright-report
coverage

# Docker meta
Dockerfile
.dockerignore

# Repo-level docs and notes (not used at runtime)
README.md
AGENTS.md
CLAUDE.md
clean.md
docs

# Tests and test configs (not needed to build or run)
e2e
playwright.config.mjs
vitest.config.mjs

# Legacy Node.js agent trees (superseded by *-dotnet). Keep out of the web image.
attendance-agent
kra-agent

# NOTE: These folders ARE packaged at runtime by Next.js route handlers and must
# be present under /app in the runner image (see Dockerfile):
#   - print-agent/                → /api/print-agent/file/[name] + bootstrap
#   - print-agent-dotnet/         → /api/print-agent/dotnet-source
#   - attendance-agent-dotnet/    → /api/attendance-agent/package
#   - kra-agent-dotnet/           → /api/kra-agent/package
# Exclude only local build/publish junk so the image stays small.
**/bin/
**/obj/
**/publish/
kra-agent-dotnet/release/
